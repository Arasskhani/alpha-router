# Prevent host node_modules/dist from overwriting a clean npm install in the image.
frontend/node_modules
frontend/dist
frontend/dist-extension
frontend/tsconfig.tsbuildinfo

# Never ship the stale compiled twins into the image build context: Vite would
# resolve them ahead of the .ts/.tsx sources and bundle old code. The image is
# always built from TypeScript.
frontend/src/**/*.js
frontend/extension/**/*.js

# Python local env and caches (runtime stage only copies backend/app)
.venv
venv
backend/.venv
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
**/.pytest_cache
*.egg-info

# Secrets and local config — injected at runtime via compose env_file
.env

# VCS and editor noise
.git
.gitignore
.idea
.vscode
.cursor
.claude

# Local databases
*.db
