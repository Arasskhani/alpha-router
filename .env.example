# =============================================================================
# Alpharouter — environment template
#
# Copy this file to `.env` and replace every placeholder below with a real value
# before running the stack:
#
#     cp .env.example .env
#
# The real `.env` is git-ignored and must NEVER be committed. All values here are
# non-secret placeholders for documentation only — do not use them in production.
#
# Scale profile (production-oriented defaults):
#   - 5,000 concurrent signed-in users
#   - ~25,000 active chat sessions fleet-wide (~5 sessions/user at peak)
#   - Capacity (4 uvicorn workers): per worker DB conns = DB_POOL_SIZE + DB_MAX_OVERFLOW
#     = 12 + 20 = 32; 4 workers -> up to 128 client connections to PgBouncer,
#     which multiplexes to ~90 real Postgres connections (see docker-compose.yml).
# =============================================================================

# Docker Compose project name (container/network/volume prefix). Default is the folder name.
COMPOSE_PROJECT_NAME=alpha-router

# --- Container registry (optional; for ./scripts/install.sh --from-registry) ----
# Example GitLab: registry.gitlab.com/your-group/alpha-router
# CI publishes: alpha-router, alpha-router-sandbox, alpha-router-sandbox-broker
ALPHAROUTER_REGISTRY=
ALPHAROUTER_IMAGE_TAG=latest
# Optional one-time registry login (prefer docker login on the host instead):
# REGISTRY_USER=
# REGISTRY_PASSWORD=

# Deployment mode.
#   development (default) — all hardening opt-in, bundled dev defaults accepted.
#   production            — startup fails closed while any known insecure
#                           fallback or plaintext transport setting is active.
ENVIRONMENT=development

# Docker Compose project name (container/network/volume prefix). Default is the folder name.
COMPOSE_PROJECT_NAME=alpha-router

# --- Database (App -> PgBouncer -> Postgres) --------------------------------
# Canonical PostgreSQL role and database identity.
POSTGRES_USER=alpha_router
POSTGRES_DB=alpha_router
# POSTGRES_PASSWORD is read by docker-compose.yml for BOTH the postgres container
# and pgbouncer (DATABASE_URL). Keep it in sync with DATABASE_URL below.
# Production: use a strong, unique, randomly generated value.
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://alpha_router:changeme@pgbouncer:6432/alpha_router

# Optional read replica for chat GET routes (list/search/messages).
# Falls back to DATABASE_URL when unset.
# DATABASE_READ_URL=postgresql+asyncpg://alpha_router:changeme@postgres-replica:5432/alpha_router

DB_POOL_SIZE=12
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=45

UVICORN_WORKERS=4

CHAT_EMPTY_SESSION_HIDE_DAYS=30

CHAT_LIST_RATE_LIMIT_PER_MIN=200
CHAT_LIST_SINCE_RATE_LIMIT_PER_MIN=600
CHAT_SEARCH_RATE_LIMIT_PER_MIN=45
CHAT_MESSAGE_SEARCH_RATE_LIMIT_PER_MIN=45

# --- Redis ------------------------------------------------------------------
# Leave REDIS_PASSWORD empty to keep legacy no-auth behavior (single-box/dev).
# To harden: set REDIS_PASSWORD and Alpharouter injects it into the Redis connection
# automatically — you do NOT need to embed credentials in REDIS_URL. The
# production guard flags an empty REDIS_PASSWORD when ENVIRONMENT=production.
#   REDIS_PASSWORD=changeme
#   REDIS_URL=redis://redis:6379/0
# The bundled redis container enables --requirepass only when REDIS_PASSWORD is set.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- Online presence (admin Users table) ------------------------------------
# Green "online" dot and the Online Users filter in Admin -> Users. Browser tabs
# refresh a short-lived Redis key while visible; nothing is stored in PostgreSQL.
# Set PRESENCE_ENABLED=false to switch the feature off without a code change.
# TTL must outlast two missed pings (the browser pings every 30s).
PRESENCE_ENABLED=true
PRESENCE_TTL_SECONDS=90

# --- Agent Knowledge data plane (Qdrant + durable workers) ------------------
# Compose exposes Qdrant only on loopback and requires this key for every API call.
# Production: replace with a long random value (for example `openssl rand -hex 32`).
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me-qdrant-api-key
QDRANT_TIMEOUT_SECONDS=10
QDRANT_COLLECTION_PREFIX=alpharouter-knowledge
QDRANT_MEMORY_COLLECTION_PREFIX=alpharouter-memory
QDRANT_REPLICATION_FACTOR=1
MEMORY_EXTRACT_ENABLED=true
MEMORY_JOB_LEASE_SECONDS=120
MEMORY_JOB_MAX_ATTEMPTS=5
MEMORY_RETRY_BASE_SECONDS=5
KNOWLEDGE_STREAM_NAME=alpharouter:knowledge:jobs
KNOWLEDGE_DEAD_LETTER_STREAM_NAME=alpharouter:knowledge:dead
KNOWLEDGE_CONSUMER_GROUP=alpharouter-knowledge-workers
KNOWLEDGE_WORKER_BATCH_SIZE=10
KNOWLEDGE_JOB_LEASE_SECONDS=120
KNOWLEDGE_JOB_MAX_ATTEMPTS=5
KNOWLEDGE_CONNECTOR_POLL_INTERVAL_SECONDS=60
KNOWLEDGE_RETENTION_POLL_INTERVAL_SECONDS=3600
KNOWLEDGE_RETENTION_BATCH_SIZE=100
KNOWLEDGE_MAX_UPLOAD_BYTES=52428800
KNOWLEDGE_QUARANTINE_PREFIX=private/knowledge/quarantine
KNOWLEDGE_OBJECT_PREFIX=private/knowledge/documents
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_SECONDS=120
CLAMAV_REQUIRED=true
KNOWLEDGE_OCR_REQUIRED=true
KNOWLEDGE_OCR_LANGUAGES=fas+eng
KNOWLEDGE_OCR_DPI=200
KNOWLEDGE_OCR_PAGE_TIMEOUT_SECONDS=45
KNOWLEDGE_OCR_MAX_PAGES=500
KNOWLEDGE_PARSER_TIMEOUT_SECONDS=300
KNOWLEDGE_PARSER_MEMORY_BYTES=1610612736
KNOWLEDGE_PARSER_CPU_SECONDS=240
KNOWLEDGE_PARSER_MAX_OUTPUT_BYTES=100663296
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_EMBEDDING_MAX_INPUT_CHARACTERS=16000
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=60
KNOWLEDGE_INDEX_UPSERT_BATCH_SIZE=128
KNOWLEDGE_RETRIEVAL_MAX_QUERY_CHARACTERS=8000
KNOWLEDGE_RETRIEVAL_CANDIDATE_LIMIT=40
KNOWLEDGE_RETRIEVAL_FINAL_LIMIT=8
KNOWLEDGE_RETRIEVAL_RRF_K=60
KNOWLEDGE_RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=3
KNOWLEDGE_RETRIEVAL_CONTEXT_TOKEN_BUDGET=6000
KNOWLEDGE_RETRIEVAL_DENSE_SCORE_THRESHOLD=0.05
KNOWLEDGE_RETRIEVAL_SPARSE_SCORE_THRESHOLD=0.01
# Specialist Agent runtime ceilings. Agent-version policies can only lower
# these values; they cannot create unbounded handoff or tool-call loops.
AGENT_ROUTER_MAX_CANDIDATES=64
AGENT_ROUTER_MINIMUM_CONFIDENCE=0.30
AGENT_ROUTER_MINIMUM_MARGIN=0.10
AGENT_MAX_HANDOFFS_PER_TURN=2
AGENT_MAX_TOOL_CALLS_PER_TURN=8
AGENT_MAX_TOOL_HOPS_PER_TURN=3
AGENT_TOOL_DEFAULT_TIMEOUT_SECONDS=20
AGENT_TOOL_MAX_OUTPUT_BYTES=262144
AGENT_TURN_TIMEOUT_SECONDS=180
AGENT_MAX_SYSTEM_PROMPT_CHARACTERS=100000
OUTBOX_BATCH_SIZE=100

# --- Evaluation and observability -------------------------------------------
# /metrics is Prometheus-compatible and emits only bounded labels. Configure
# PROMETHEUS_MULTIPROC_DIR in the process supervisor when using >1 worker
# (Docker Compose does this automatically).
METRICS_ENABLED=true
# Required when metrics are enabled in production. Configure the Prometheus
# scrape job with Authorization: Bearer <this value>.
METRICS_BEARER_TOKEN=
JSON_LOGGING_ENABLED=true
# OTLP tracing is opt-in and fails startup when enabled without an endpoint.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=alpharouter
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_TRACE_SAMPLE_RATIO=0.10

# --- App secrets & admin bootstrap ------------------------------------------
# Production: generate a long random SECRET_KEY, e.g. `openssl rand -hex 32`.
# The startup guard rejects the literal placeholders below when ENVIRONMENT=production.
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=alpharouter
ADMIN_PASSWORD=admin
SERVICE_ADMIN_PASSWORD=changeme
API_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# --- Phase 9: production guard, data key, OpenAPI lockdown -------------------
# production_guard_mode: "hard-fail" (default) refuses to boot on insecure
# fallbacks. "warning" is a temporary migration override, not a secure default.
PRODUCTION_GUARD_MODE=hard-fail
# Dedicated data-at-rest encryption key. No alternate key is tried.
# Production must replace this placeholder; generate with `openssl rand -hex 32`.
DATA_ENCRYPTION_KEY=change-me-in-production
# Lock /docs, /redoc, /openapi.json to Super Admin in production. The guard
# flags a False value in production. Leave false in development.
OPENAPI_ADMIN_ONLY=false

# JWT lifetime in minutes. Default 480 (8h). Revocation is enforced via a
# per-user token_version counter (bumped on logout / password reset / admin
# disable), so tokens are also revocable before this natural expiry.
JWT_EXPIRE_MINUTES=480
ENABLE_COOKIE_AUTH=true
ENABLE_CSRF=true
SESSION_COOKIE_NAME=alpha_router_session
CSRF_COOKIE_NAME=alpha_router_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# OpenAI-compatible gateway master key (Open WebUI / external clients -> Alpharouter).
# Production: replace "master" with a strong random suffix.
GATEWAY_MASTER_KEY=sk-alpha-router-master

# --- Code interpreter sandbox broker ----------------------------------------
# Generate an independent random token of at least 32 characters. Alpharouter sends
# only code/files to the internal broker; Docker socket access is broker-only.
# Compose injects CODE_SANDBOX_BROKER_TOKEN from SANDBOX_BROKER_TOKEN for the app
# container. When running the API locally (uvicorn), set CODE_SANDBOX_BROKER_TOKEN
# to the same value so broker auth succeeds.
SANDBOX_BROKER_TOKEN=
CODE_SANDBOX_BROKER_URL=http://alpha-router-sandbox-broker:8081
CODE_SANDBOX_BROKER_TOKEN=
CODE_SANDBOX_TIMEOUT_SECONDS=20
# Cross-worker Code Interpreter turn admission (Redis leased semaphore).
# Global concurrent-turn ceiling; request over capacity is rejected immediately
# (no queue) with HTTP 429 + Retry-After. Fail-closed if Redis is unavailable.
CODE_INTERPRETER_CAPACITY_GLOBAL_MAX=200
CODE_INTERPRETER_CAPACITY_PER_SUBJECT_MAX=2
CODE_INTERPRETER_CAPACITY_LEASE_TTL_SECONDS=900
CODE_INTERPRETER_CAPACITY_HEARTBEAT_SECONDS=30
CODE_INTERPRETER_CAPACITY_RETRY_AFTER_SECONDS=30
# Broker infrastructure ceilings. Admin workspace policy is enforced upstream;
# these remain higher, fixed DoS guards and must not be treated as product limits.
SANDBOX_MAX_CONCURRENT=200
SANDBOX_QUEUE_TIMEOUT_SECONDS=0.1
SANDBOX_RETRY_AFTER_SECONDS=30
SANDBOX_HARD_MAX_WORKSPACE_FILES=1000
SANDBOX_HARD_MAX_WORKSPACE_FILE_BYTES=67108864
SANDBOX_HARD_MAX_WORKSPACE_TOTAL_BYTES=67108864
SANDBOX_HARD_MAX_REQUEST_BYTES=75497472
SANDBOX_JOB_RETENTION_SECONDS=300
SANDBOX_MAX_TRACKED_JOBS=10000
# `docker compose up --build -d` builds the sandbox image through a one-shot
# initializer (Exited 0 is expected); the broker starts disposable containers.

# --- Bounded uploads, remote fetches, images and ZIP exports -----------------
# Values are bytes unless noted. Runtime clamps every override to a hard safety
# ceiling; lowering these values is supported for smaller deployments.
MAX_REQUEST_BODY_BYTES=67108864
MAX_ATTACHMENT_BYTES=12582912
MAX_ATTACHMENTS_TOTAL_BYTES=37748736
MAX_VOICE_UPLOAD_BYTES=26214400
MAX_MEDIA_INPUT_BYTES=26214400
MAX_WEB_FETCH_BYTES=2097152
MAX_IMAGE_SIDE_PX=4096
MAX_IMAGE_PIXELS=16777216
MAX_ZIP_ITEMS=100
MAX_ZIP_SINGLE_FILE_BYTES=52428800
MAX_ZIP_AGGREGATE_BYTES=268435456

# Atomic in-flight budget/API-key reservations
BUDGET_CHAT_FALLBACK_HOLD_USD=0.05
BUDGET_EMBEDDING_FALLBACK_HOLD_USD=0.01
BUDGET_IMAGE_FALLBACK_HOLD_USD=0.25
BUDGET_VIDEO_FALLBACK_HOLD_USD=1.50
BUDGET_AUDIO_FALLBACK_HOLD_USD=0.10
BUDGET_TOOL_FALLBACK_HOLD_USD=0.05
BUDGET_MAX_HOLD_USD=5.0
BUDGET_RESERVATION_TTL_SECONDS=7200
COST_RECONCILIATION_ENABLED=true
COST_RECONCILIATION_INTERVAL_MINUTES=30
COST_RECONCILIATION_BATCH_SIZE=50

# Video generation (OpenRouter /videos async jobs)
VIDEO_MAX_DURATION_SECONDS=8
VIDEO_MAX_RESOLUTION=1080p
VIDEO_MAX_OUTPUT_BYTES=209715200
VIDEO_MAX_CONCURRENT_JOBS_PER_USER=1
VIDEO_JOB_POLL_INTERVAL_MS=2500
VIDEO_JOB_TIMEOUT_SECONDS=600
VIDEO_JOB_RECLAIM_AFTER_SECONDS=900

# --- SSRF protection ---------------------------------------------------------
# Block user-supplied fetches that resolve to private/loopback/metadata IPs.
# Emergency rollback for connection-time DNS pinning only; URL/IP/redirect
# validation remains enabled. Keep true after canary verification.
ENABLE_SSRF_DNS_PINNING=true

# =============================================================================
# DANGEROUS OPT-IN FLAGS — leave ALL of these false unless you have a written
# exception for an isolated lab. Enabling any of them weakens core controls.
# Production startup rejects several of these outright (hard-fail guard).
# Do NOT copy "true" from blog posts / old labs into a shared or public host.
# =============================================================================
# Browser JWT in Authorization header (bypasses cookie + CSRF double-submit).
# Prefer session cookies. Machine clients must use /v1 API keys instead.
ALLOW_LEGACY_BEARER_AUTH=false
# Disables private-IP blocking in ssrf_guard (and SAML metadata URL checks).
# Safer alternative for internal IdPs: upload SAML Metadata XML in Admin → Auth.
# Safer alternative for private docs: publish a public/proxy URL, do not open SSRF.
ALLOW_SSRF_PRIVATE_RANGES=false
# Runs code-interpreter Python on the API host via subprocess (development only).
# Safer alternative: keep CODE_SANDBOX_BROKER_URL + SANDBOX_BROKER_TOKEN configured.
ALLOW_INSECURE_CODE_SUBPROCESS=false

# --- Browser security headers (Phase 8) --------------------------------------
# Report-Only CSP is enabled by default in application config and does not
# block resources. Override with an empty value to disable the canary.
# CONTENT_SECURITY_POLICY_REPORT_ONLY="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'"
#
# HSTS: only emitted when ENABLE_HSTS=true, ENVIRONMENT=production, and the
# request is HTTPS (directly or via X-Forwarded-Proto). Keep disabled until the
# production TLS path is manually verified. Start with a short max-age.
ENABLE_HSTS=false
HSTS_MAX_AGE_SECONDS=300
HSTS_INCLUDE_SUBDOMAINS=false
# Enforced CSP remains empty until the Report-Only browser canary is approved.
CONTENT_SECURITY_POLICY=

# --- Password policy (Phase 7) ------------------------------------------------
# Minimum length for local-account passwords set via admin create-user /
# password-reset. The bootstrap admin password from ADMIN_PASSWORD is NOT
# subject to this (it is an operational bootstrap secret). Default: 8.
PASSWORD_MIN_LENGTH=8

# --- Object storage (SeaweedFS / S3-compatible) -----------------------------
# S3_ACCESS_KEY / S3_SECRET_KEY are used by the app (boto3) and by SeaweedFS
# (mapped to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in docker-compose.yml).
# Production: use strong random values (not changeme / rustfsadmin).
# Compose overrides S3_ENDPOINT_URL to http://seaweedfs:8333 for the Alpharouter service.
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=alpha_router
S3_SECRET_KEY=changeme
S3_BUCKET=alpha-router-media
MEDIA_CDN_PREFIX=cdn
# SeaweedFS Admin UI (http://127.0.0.1:23646) — required by compose.
SEAWEEDFS_ADMIN_PASSWORD=change-me-seaweed-admin

# --- LDAP (optional) --------------------------------------------------------
LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap.example.com
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=
# Active Directory from Docker/Linux uses direct LDAPS only (port 636).
# Configure the DC certificate in Admin → Authentication.

# --- SAML 2.0 SP (optional; prefer Admin → Authentication) ------------------
# Alpharouter acts as a SAML Service Provider. Configure IdP metadata in the admin UI
# (or set SAML_IDP_METADATA_URL as env fallback). ACS is fixed at
# /api/auth/saml/acs. API_PUBLIC_URL must be HTTPS in production when SAML is on.
SAML_ENABLED=false
SAML_IDP_METADATA_URL=
SAML_ENTITY_ID=

# --- OIDC (optional; prefer Admin → Authentication) ------------------------
# Generic OpenID Connect (Authorization Code + PKCE). Prefer configuring in the
# admin UI. Callback is fixed at /api/auth/oidc/callback. Issuer and
# API_PUBLIC_URL must be HTTPS in production when OIDC is enabled.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
