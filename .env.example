# =============================================================================
# Alpha Router scale profile (production-oriented defaults)
# - 5,000 concurrent signed-in users
# - ~25,000 active chat sessions fleet-wide (~5 sessions/user at peak)
# - 10+ browser tabs per user (leader-tab: only 1 tab writes; others read/debounce)
#
# Capacity (4 uvicorn workers):
#   per worker max DB conns = DB_POOL_SIZE + DB_MAX_OVERFLOW = 12 + 20 = 32
#   4 workers → up to 128 client connections to PgBouncer
# PgBouncer multiplexes to ~90 real Postgres connections (see docker-compose.yml)
# =============================================================================

# Deployment mode.
#   development (default) — all hardening opt-in, bundled dev defaults accepted.
#   production            — startup refuses to boot while SECRET_KEY/ADMIN_PASSWORD/
#                           GATEWAY_MASTER_KEY still hold the insecure defaults below.
ENVIRONMENT=development

# App → PgBouncer → Postgres (Docker). For local dev without PgBouncer use postgres:5432 directly.
# POSTGRES_PASSWORD is read by docker-compose.yml for BOTH the postgres container
# (POSTGRES_PASSWORD) and pgbouncer (DATABASE_URL). Keep it in sync with DATABASE_URL below.
# For production: rotate to a strong random value (see Phase 0 secret rotation).
POSTGRES_PASSWORD=alpha-router
DATABASE_URL=postgresql+asyncpg://alpha_router:alpha_router@pgbouncer:6432/alpha-router

# Optional read replica for chat GET routes (list/search/messages). Falls back to DATABASE_URL when unset.
# DATABASE_READ_URL=postgresql+asyncpg://alpha_router:alpha_router@postgres-replica:5432/alpha-router

DB_POOL_SIZE=12
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=45

UVICORN_WORKERS=4

CHAT_EMPTY_SESSION_HIDE_DAYS=30

CHAT_LIST_RATE_LIMIT_PER_MIN=200
CHAT_LIST_SINCE_RATE_LIMIT_PER_MIN=600
CHAT_SEARCH_RATE_LIMIT_PER_MIN=45
CHAT_MESSAGE_SEARCH_RATE_LIMIT_PER_MIN=45

# Redis. Leave REDIS_PASSWORD empty to keep legacy no-auth behavior (single-box/dev).
# To harden: set REDIS_PASSWORD and embed it in REDIS_URL, e.g.
#   REDIS_PASSWORD=s3cret
#   REDIS_URL=redis://:s3cret@redis:6379/0
# The bundled redis container enables --requirepass only when REDIS_PASSWORD is set.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SERVICE_ADMIN_PASSWORD=***REMOVED***
API_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
GATEWAY_MASTER_KEY=sk-alpha-router-master

S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY / S3_SECRET_KEY are read by docker-compose.yml for BOTH the app
# (S3 client) and the MinIO container (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD).
# For production: rotate to strong random values (see Phase 0 secret rotation).
S3_ACCESS_KEY=alpha-router
S3_SECRET_KEY=***REMOVED***
S3_BUCKET=alpha-router-media
MEDIA_CDN_PREFIX=cdn

LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap.example.com
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=

KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM=alpha-router
KEYCLOAK_CLIENT_ID=alpha-router-ui
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:8080/api/auth/keycloak/callback
