# =============================================================================
# NITRO — environment template
#
# Copy this file to `.env` and replace every placeholder below with a real value
# before running the stack:
#
#     cp .env.example .env
#
# The real `.env` is git-ignored and must NEVER be committed. All values here are
# non-secret placeholders for documentation only — do not use them in production.
#
# Scale profile (production-oriented defaults):
#   - 5,000 concurrent signed-in users
#   - ~25,000 active chat sessions fleet-wide (~5 sessions/user at peak)
#   - Capacity (4 uvicorn workers): per worker DB conns = DB_POOL_SIZE + DB_MAX_OVERFLOW
#     = 12 + 20 = 32; 4 workers -> up to 128 client connections to PgBouncer,
#     which multiplexes to ~90 real Postgres connections (see docker-compose.yml).
# =============================================================================

# Deployment mode.
#   development (default) — all hardening opt-in, bundled dev defaults accepted.
#   production            — startup refuses to boot while SECRET_KEY / ADMIN_PASSWORD /
#                           GATEWAY_MASTER_KEY still hold the insecure defaults below.
ENVIRONMENT=development

# --- Database (App -> PgBouncer -> Postgres) --------------------------------
# POSTGRES_PASSWORD is read by docker-compose.yml for BOTH the postgres container
# and pgbouncer (DATABASE_URL). Keep it in sync with DATABASE_URL below.
# Production: use a strong, unique, randomly generated value.
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://nitro:changeme@pgbouncer:6432/nitro

# Optional read replica for chat GET routes (list/search/messages).
# Falls back to DATABASE_URL when unset.
# DATABASE_READ_URL=postgresql+asyncpg://nitro:changeme@postgres-replica:5432/nitro

DB_POOL_SIZE=12
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=45

UVICORN_WORKERS=4

CHAT_EMPTY_SESSION_HIDE_DAYS=30

CHAT_LIST_RATE_LIMIT_PER_MIN=200
CHAT_LIST_SINCE_RATE_LIMIT_PER_MIN=600
CHAT_SEARCH_RATE_LIMIT_PER_MIN=45
CHAT_MESSAGE_SEARCH_RATE_LIMIT_PER_MIN=45

# --- Redis ------------------------------------------------------------------
# Leave REDIS_PASSWORD empty to keep legacy no-auth behavior (single-box/dev).
# To harden: set REDIS_PASSWORD and embed it in REDIS_URL, e.g.
#   REDIS_PASSWORD=changeme
#   REDIS_URL=redis://:changeme@redis:6379/0
# The bundled redis container enables --requirepass only when REDIS_PASSWORD is set.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- App secrets & admin bootstrap ------------------------------------------
# Production: generate a long random SECRET_KEY, e.g. `openssl rand -hex 32`.
# The startup guard rejects the literal placeholders below when ENVIRONMENT=production.
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SERVICE_ADMIN_PASSWORD=changeme
API_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# OpenAI-compatible gateway master key (Open WebUI / external clients -> NITRO).
# Production: use a strong random token, e.g. `sk-` + `openssl rand -hex 24`.
GATEWAY_MASTER_KEY=sk-nitro-master

# --- Code interpreter sandbox (Phase 2) -------------------------------------
# When CODE_SANDBOX_IMAGE is set, user code from the chat runs in a disposable,
# network-less, read-only container with no app secrets (spawned via the Docker
# socket mounted into the nitro service). Leave empty to use the legacy in-process
# subprocess (dev / no-docker only). Build the image: docker compose build sandbox
CODE_SANDBOX_IMAGE=nitro-sandbox:latest
CODE_SANDBOX_TIMEOUT_SECONDS=20
CODE_SANDBOX_MEMORY=256m
CODE_SANDBOX_PIDS_LIMIT=128

# --- SSRF protection (Phase 5) -----------------------------------------------
# Block user-supplied fetches (web-fetch chat tool, image reference URLs, media
# import source_url) that resolve to private/loopback/link-local/metadata IPs.
# Keep false in production. Set true ONLY for self-hosted internal deployments
# where users must fetch from private documentation servers.
ALLOW_SSRF_PRIVATE_RANGES=false

# --- Security headers (Phase 5) ----------------------------------------------
# HSTS: only emitted when ENABLE_HSTS=true AND ENVIRONMENT=production (behind
# HTTPS). Leave false if serving HTTP directly or behind a terminating proxy
# that already sets HSTS.
ENABLE_HSTS=false
# CSP: opt-in. Empty = no CSP header. The SPA uses React inline styles, so a
# working CSP needs `style-src 'self' 'unsafe-inline'`. Example:
#   CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
CONTENT_SECURITY_POLICY=

# --- Object storage (MinIO / S3-compatible) ---------------------------------
# S3_ACCESS_KEY / S3_SECRET_KEY are read by docker-compose.yml for BOTH the app
# (S3 client) and the MinIO container (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD).
# Production: use strong random values.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nitro-media
MEDIA_CDN_PREFIX=cdn

# --- LDAP (optional) --------------------------------------------------------
LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap.example.com
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=

# --- Keycloak OIDC (optional) -----------------------------------------------
KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM=nitro
KEYCLOAK_CLIENT_ID=nitro-ui
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:8080/api/auth/keycloak/callback
