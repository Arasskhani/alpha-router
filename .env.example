# =============================================================================
# NITRO scale profile (production-oriented defaults)
# - 5,000 concurrent signed-in users
# - ~25,000 active chat sessions fleet-wide (~5 sessions/user at peak)
# - 10+ browser tabs per user (leader-tab: only 1 tab writes; others read/debounce)
#
# Capacity (4 uvicorn workers):
#   per worker max DB conns = DB_POOL_SIZE + DB_MAX_OVERFLOW = 12 + 20 = 32
#   4 workers → up to 128 client connections to PgBouncer
# PgBouncer multiplexes to ~90 real Postgres connections (see docker-compose.yml)
# =============================================================================

# App → PgBouncer → Postgres (Docker). For local dev without PgBouncer use postgres:5432 directly.
DATABASE_URL=postgresql+asyncpg://nitro:nitro@pgbouncer:6432/nitro

# Optional read replica for chat GET routes (list/search/messages). Falls back to DATABASE_URL when unset.
# DATABASE_READ_URL=postgresql+asyncpg://nitro:nitro@postgres-replica:5432/nitro

DB_POOL_SIZE=12
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=45

UVICORN_WORKERS=4

CHAT_EMPTY_SESSION_HIDE_DAYS=30

CHAT_LIST_RATE_LIMIT_PER_MIN=200
CHAT_LIST_SINCE_RATE_LIMIT_PER_MIN=600
CHAT_SEARCH_RATE_LIMIT_PER_MIN=45
CHAT_MESSAGE_SEARCH_RATE_LIMIT_PER_MIN=45

REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SERVICE_ADMIN_PASSWORD=***REMOVED***
API_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
GATEWAY_MASTER_KEY=sk-nitro-master

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=nitro
S3_SECRET_KEY=***REMOVED***
S3_BUCKET=nitro-media
MEDIA_CDN_PREFIX=cdn

LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap.example.com
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=

KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM=nitro
KEYCLOAK_CLIENT_ID=nitro-ui
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:8080/api/auth/keycloak/callback
