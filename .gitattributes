# Normalize all text files to LF in the repo and on checkout.
# The stack runs in Docker/Linux, so LF everywhere avoids CRLF/LF churn that
# otherwise shows unchanged files as "modified" on Windows (GitLab Desktop).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
