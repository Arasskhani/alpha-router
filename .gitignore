# =============================================================================
# Secrets & environment — NEVER commit real secrets to git.
# .env.example (template with placeholder values) stays tracked; .env does not.
# =============================================================================
.env
.env.local
.env.*.local
*.env.local
.env.bak
*.bak
docker-compose.override.yml

# =============================================================================
# Python — bytecode, caches, virtualenvs
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.pytest_cache/
.pytest-tmp*/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.egg-info/

# =============================================================================
# Node / frontend build artifacts
# =============================================================================
node_modules/
frontend/dist/
frontend/build/
frontend/tsconfig.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Editor / OS cruft
# =============================================================================
.vscode/
.idea/
.cursor/
*.swp
*.swo
.DS_Store
Thumbs.db

# =============================================================================
# Local data / runtime
# =============================================================================
*.sqlite
*.sqlite3
*.db
uploads/
tmp/
backups/
