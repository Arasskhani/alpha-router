# =============================================================================
# Secrets & environment — NEVER commit real secrets to git.
# .env.example (template with placeholder values) stays tracked; .env does not.
# =============================================================================
.env
.env.local
.env.*.local
*.env.local
.env.bak
.env.bak.*
.env.pre-restore.*
*.bak
docker-compose.override.yml
.alpharouter-installed

# =============================================================================
# Python — bytecode, caches, virtualenvs
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.pytest_cache/
.pytest-tmp*/
backend/tests/_tmp_request_body_limit/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.egg-info/

# =============================================================================
# Node / frontend build artifacts
# =============================================================================
node_modules/
frontend/dist/
frontend/build/
frontend/tsconfig.tsbuildinfo
# Compiled twins of the TypeScript sources. They are build output, not source:
# tsconfig sets noEmit so nothing refreshes them, while Vite happily resolves
# them ahead of the .ts/.tsx they shadow. Every module under frontend/src is
# authored in TypeScript -- if a genuine hand-written .js is ever needed there,
# add an explicit `!frontend/src/path/to/file.js` exception below.
frontend/src/**/*.js
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Editor / OS cruft
# =============================================================================
.vscode/
.idea/
.cursor/
*.swp
*.swo
.DS_Store
Thumbs.db

# =============================================================================
# Local data / runtime
# =============================================================================
*.sqlite
*.sqlite3
*.db
uploads/
tmp/
backups/

# =============================================================================
# Delivery scaffolding
# =============================================================================
# Bundles, patch series and zips produced to hand a change set over. Every one
# of them is a copy of work that is already in this history, so committing them
# doubles the repository for nothing and buries real changes in review.
_phase*/
Claude outputs/
*.bundle
# Throwaway self-signed cert/key written while testing the edge container.
# A pair once reached a commit this way (94e273c, removed in 068776a) and
# a private key cannot be un-published once it is pushed.
.tmp-edge-test/
