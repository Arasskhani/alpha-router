From fcba40b22f95fd3c61b86d4c66957a2b4dbca038 Mon Sep 17 00:00:00 2001
From: Majid Arasskhani <M.Arasskhani@gosilkroad.net>
Date: Mon, 14 Sep 2026 10:37:37 +0000
Subject: [PATCH 2/7] build(frontend): regenerate package-lock.json and install
 with npm ci in Dockerfile

The committed lockfile was internally inconsistent (vitest's nested
@esbuild/*@0.28.1 entries without the esbuild@0.28.2 parent), so 'npm ci'
failed with EUSAGE and both frontend CI jobs could not install. Regenerated
with npm install; 'npm ci' now succeeds from a clean tree.

Dockerfile switches from 'npm install' to 'npm ci' so the production image
installs exactly the dependency tree CI tested, and the package-lock.json*
glob is dropped so a missing lockfile fails the build instead of silently
resolving a different tree.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UTnpHajSmkk2JMLfuQoV7o
---
 Dockerfile                 |   5 +-
 frontend/package-lock.json | 249 ++++++++++++++++++++++++-------------
 2 files changed, 165 insertions(+), 89 deletions(-)

diff --git a/Dockerfile b/Dockerfile
index eb4bb8b2..8a4598b5 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,8 +1,9 @@
 # Multi-stage production image: React frontend + FastAPI backend
 FROM node:20-alpine AS frontend-build
 WORKDIR /fe
-COPY frontend/package.json frontend/package-lock.json* ./
-RUN npm install
+COPY frontend/package.json frontend/package-lock.json ./
+# npm ci: install exactly what CI tested; fails loudly if the lockfile is missing or drifts.
+RUN npm ci --no-audit --no-fund
 COPY frontend/ .
 RUN npm run build
 
