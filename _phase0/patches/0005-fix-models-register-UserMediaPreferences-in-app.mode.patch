From 3b20fbf226e8780c487827e8e3e6ce379ac56b4f Mon Sep 17 00:00:00 2001
From: Majid Arasskhani <M.Arasskhani@gosilkroad.net>
Date: Mon, 14 Sep 2026 10:53:28 +0000
Subject: [PATCH 5/7] fix(models): register UserMediaPreferences in app.models

user_media_preferences reached Base.metadata only via incidental imports in
api/user_media.py, user_media_service.py and scheduler.py. alembic/env.py
imports app.models alone, so an 'alembic revision --autogenerate' would have
emitted DROP TABLE for it, and removing any of those incidental imports (as
the unused-import cleanup does) would have silently dropped it from
create_all. Import it where every other model is registered.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UTnpHajSmkk2JMLfuQoV7o
---
 backend/app/models/__init__.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/backend/app/models/__init__.py b/backend/app/models/__init__.py
index 25876aff..0508de38 100644
--- a/backend/app/models/__init__.py
+++ b/backend/app/models/__init__.py
@@ -109,6 +109,7 @@ from app.models.system import (
     SystemSetting,
 )
 from app.models.user import User, UserGroup, UserRoleAssignment, user_group_members
+from app.models.user_media_prefs import UserMediaPreferences
 from app.models.video import VideoGenerationJob
 
 __all__ = [
@@ -206,6 +207,7 @@ __all__ = [
     "UserMemoryJob",
     "UserMemorySuppression",
     "UserRoleAssignment",
+    "UserMediaPreferences",
     "VideoGenerationJob",
     "user_group_members",
     "alpha_router_api_key_connections",
