From 18c93755a3b2808b60f38dfe727563f4293b42c1 Mon Sep 17 00:00:00 2001
From: Majid Arasskhani <M.Arasskhani@gosilkroad.net>
Date: Mon, 14 Sep 2026 14:15:20 +0000
Subject: [PATCH 09/10] ci: scan the four first-party images with Trivy and
 publish CycloneDX SBOMs

publish-images built and pushed alpha-router, alpha-router-sandbox,
alpha-router-sandbox-broker and alpha-router-edge without any vulnerability
scan; only the third-party SeaweedFS image had one. The job now runs Trivy
(fail on fixable CRITICAL/HIGH) against each built image before pushing and
stores a CycloneDX SBOM per image as a 90-day pipeline artifact.

Trivy runs as a container talking to the dind daemon (DOCKER_HOST is already
set for the job), so no extra services are needed.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UTnpHajSmkk2JMLfuQoV7o
---
 .gitlab-ci.yml | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
index de9b9f7..4688b1c 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -221,6 +221,15 @@ publish-images:
     - docker build -t "$CI_REGISTRY_IMAGE/alpha-router-sandbox:$TAG" -f sandbox/Dockerfile sandbox
     - docker build -t "$CI_REGISTRY_IMAGE/alpha-router-sandbox-broker:$TAG" -f sandbox-broker/Dockerfile .
     - docker build -t "$CI_REGISTRY_IMAGE/alpha-router-edge:$TAG" -f deploy/edge/Dockerfile .
+    # Scan what we are about to ship: fail on fixable CRITICAL/HIGH findings
+    # and keep a CycloneDX SBOM per image as a pipeline artifact. Until now only
+    # the third-party SeaweedFS image was scanned.
+    - mkdir -p sbom
+    - |
+      for name in alpha-router alpha-router-sandbox alpha-router-sandbox-broker alpha-router-edge; do
+        docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v "$PWD/sbom:/sbom"           -e DOCKER_HOST="$DOCKER_HOST" aquasec/trivy:0.62.1 image           --exit-code 1 --severity CRITICAL,HIGH --ignore-unfixed "$CI_REGISTRY_IMAGE/${name}:$TAG"
+        docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v "$PWD/sbom:/sbom"           -e DOCKER_HOST="$DOCKER_HOST" aquasec/trivy:0.62.1 image           --format cyclonedx --output "/sbom/${name}-${TAG}.cdx.json" "$CI_REGISTRY_IMAGE/${name}:$TAG"
+      done
     - docker push "$CI_REGISTRY_IMAGE/alpha-router:$TAG"
     - docker push "$CI_REGISTRY_IMAGE/alpha-router-sandbox:$TAG"
     - docker push "$CI_REGISTRY_IMAGE/alpha-router-sandbox-broker:$TAG"
@@ -232,3 +241,8 @@ publish-images:
           docker push "$CI_REGISTRY_IMAGE/${name}:latest"
         done
       fi
+  artifacts:
+    when: always
+    expire_in: 90 days
+    paths:
+      - sbom/
-- 
