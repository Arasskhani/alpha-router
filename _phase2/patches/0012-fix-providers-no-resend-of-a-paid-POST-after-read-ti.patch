+_SAFE_TO_RESEND_EXC: tuple[type[BaseException], ...] = (
+    httpx.ConnectError,
+    httpx.ConnectTimeout,
+    httpx.PoolTimeout,
+    httpx.WriteError,
+    httpx.WriteTimeout,
+    httpcore.ConnectError,
+    httpcore.WriteError,
+)
+
