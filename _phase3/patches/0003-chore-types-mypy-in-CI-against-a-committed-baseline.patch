From ba6ff5aff73738962a1249ab92b6a393db6d6934 Mon Sep 17 00:00:00 2001
From: Majid Arasskhani <M.Arasskhani@gosilkroad.net>
Date: Mon, 14 Sep 2026 18:57:54 +0000
Subject: [PATCH 03/11] chore(types): mypy in CI against a committed baseline

`scripts/mypy-check.sh` runs mypy (backend/mypy.ini) and filters the
output through mypy-baseline; any error not listed in
backend/mypy-baseline.txt fails the job. `--sync` regenerates the file
after a fix. 144 errors / 42 files are frozen today.

Two real fixes were needed before mypy could run at all:
- ldap_config: a backslash inside an f-string expression (PEP 701) is
  valid Python 3.12 but mypy's parser rejects it; the split is hoisted
  into a variable.
- main.py: `import app.models` bound the *package* to the name `app`,
  which the module later rebinds to the FastAPI instance. It worked at
  runtime only because of ordering; it is now `import app.models as
  _orm_models` and 45 spurious "Module has no attribute" errors vanish.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UTnpHajSmkk2JMLfuQoV7o
---
 .gitlab-ci.yml                      |  12 ++
 backend/app/main.py                 |   2 +-
 backend/app/services/ldap_config.py |   3 +-
 backend/mypy-baseline.txt           | 186 ++++++++++++++++++++++++++++
 backend/mypy.ini                    |  12 ++
 scripts/mypy-check.sh               |  11 ++
 6 files changed, 224 insertions(+), 2 deletions(-)
 create mode 100644 backend/mypy-baseline.txt
 create mode 100644 backend/mypy.ini
 create mode 100644 scripts/mypy-check.sh

diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
index efd8bb4a..8af4be1e 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -41,6 +41,18 @@ backend-lint:
     # Full rule set (backend/ruff.toml) plus formatting; both are hard gates.
     - cd backend && ruff check . && ruff format --check .
 
+# Type errors are frozen in backend/mypy-baseline.txt; the job fails on any
+# error not in the baseline. Fix errors and run `scripts/mypy-check.sh --sync`
+# to shrink it — never to grow it.
+backend-typecheck:
+  stage: verify
+  image: python:3.12-slim
+  <<: *backend-rules
+  script:
+    - python -m pip install --no-cache-dir -r backend/requirements.txt
+    - python -m pip install --no-cache-dir "mypy==1.20.2" mypy-baseline
+    - bash scripts/mypy-check.sh
+
 backend-tests:
   stage: verify
   image: python:3.12-slim
diff --git a/backend/app/main.py b/backend/app/main.py
index d2010b2f..8c5e5c6e 100644
--- a/backend/app/main.py
+++ b/backend/app/main.py
@@ -13,7 +13,7 @@ from fastapi.responses import FileResponse, HTMLResponse, JSONResponse, Response
 from fastapi.staticfiles import StaticFiles
 from sqlalchemy import select, text
 
-import app.models  # Register every ORM table before schema startup.
+import app.models as _orm_models  # noqa: F401 -- registers every ORM table before schema startup
 from app.api import (
     admin,
     admin_agent_evaluations,
