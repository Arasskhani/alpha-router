diff --git a/backend/mypy.ini b/backend/mypy.ini
new file mode 100644
index 00000000..34d86497
--- /dev/null
+++ b/backend/mypy.ini
@@ -0,0 +1,12 @@
+# Phase 3: mypy runs in CI against a committed baseline (mypy-baseline.txt).
+# `mypy-baseline filter` fails the job on any error that is not in the
+# baseline; `mypy-baseline sync` regenerates it after a deliberate fix.
+# The baseline may only shrink.
+[mypy]
+python_version = 3.12
+ignore_missing_imports = True
+follow_imports = normal
+show_error_codes = True
+warn_unused_ignores = False
+no_implicit_optional = True
+exclude = (?x)(^alembic/|^tests/)
diff --git a/scripts/mypy-check.sh b/scripts/mypy-check.sh
new file mode 100644
index 00000000..dd0f541a
--- /dev/null
+++ b/scripts/mypy-check.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+# Type-check the backend against the committed baseline.
+#   scripts/mypy-check.sh          -> fail on errors not in backend/mypy-baseline.txt
+#   scripts/mypy-check.sh --sync   -> rewrite the baseline (after fixing errors; it may only shrink)
+set -euo pipefail
+cd "$(dirname "$0")/../backend"
+mode="${1:-filter}"
+case "$mode" in
+  --sync) (mypy app || true) | mypy-baseline sync --baseline-path mypy-baseline.txt --sort-baseline ;;
+  *)      (mypy app || true) | mypy-baseline filter --baseline-path mypy-baseline.txt --sort-baseline --no-colors ;;
+esac
