diff --git a/scripts/check-commit-message.py b/scripts/check-commit-message.py
new file mode 100644
index 00000000..89afdaff
--- /dev/null
+++ b/scripts/check-commit-message.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""Conventional Commits check for the commit-msg hook (no Node dependency).
+
+Accepted subject line:
+
+    <type>(<scope>)?(!)?: <description>
+
+types: build chore ci docs feat fix perf refactor revert style test
+The description starts lowercase or with a symbol/identifier, has no trailing
+period, and the whole subject is at most 100 characters. Merge and revert
+commits generated by git, and fixup!/squash! prefixes, are accepted as-is.
+
+Usage: check-commit-message.py <path-to-COMMIT_EDITMSG>
+"""
+
+from __future__ import annotations
+
+import re
+import sys
+from pathlib import Path
+
+TYPES = ("build", "chore", "ci", "docs", "feat", "fix", "perf", "refactor", "revert", "style", "test")
+SUBJECT_RE = re.compile(
+    r"^(?P<type>" + "|".join(TYPES) + r")"
+    r"(\((?P<scope>[a-z0-9][a-z0-9._/-]*)\))?"
+    r"(?P<bang>!)?: "
+    r"(?P<desc>\S.*)$"
+)
+MAX_SUBJECT = 100
+
+
+def check(message: str) -> list[str]:
+    lines = [line for line in message.splitlines() if not line.startswith("#")]
+    subject = next((line for line in lines if line.strip()), "")
+    if not subject:
+        return ["empty commit message"]
+    if subject.startswith(("Merge ", "Revert ", "fixup! ", "squash! ")):
+        return []
+    problems: list[str] = []
+    if len(subject) > MAX_SUBJECT:
+        problems.append(f"subject is {len(subject)} characters; keep it under {MAX_SUBJECT}")
+    match = SUBJECT_RE.match(subject)
+    if not match:
+        problems.append(
+            "subject must look like `type(scope): description` with type in " + ", ".join(TYPES)
+        )
+        return problems
+    desc = match.group("desc")
+    if desc.endswith("."):
+        problems.append("description must not end with a period")
+    if desc[0].isalpha() and desc[0].isupper() and not desc.split()[0].isupper():
+        # "Redis" / "SAML" style proper nouns are fine; "Fix the thing" is not.
+        problems.append("description starts lowercase (`fix: add ...`, not `fix: Add ...`)")
+    body = lines[1:]
+    if body and body[0].strip():
+        problems.append("leave one blank line between the subject and the body")
+    return problems
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) != 1:
+        print(__doc__)
+        return 2
+    message = Path(argv[0]).read_text(encoding="utf-8", errors="replace")
+    problems = check(message)
+    if not problems:
+        return 0
+    print("Commit message rejected:")
+    for problem in problems:
+        print(f"  - {problem}")
+    print("\nSee CONTRIBUTING.md (Conventional Commits).")
+    return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
diff --git a/scripts/tests/test-commit-message.sh b/scripts/tests/test-commit-message.sh
new file mode 100644
index 00000000..dc7a4e47
--- /dev/null
+++ b/scripts/tests/test-commit-message.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# The commit-msg hook accepts our history and rejects the classic mistakes.
+set -euo pipefail
+cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
+pass=0; fail=0
+expect() { # expect <0|1> <message>
+  printf '%s\n' "$2" > "$tmp"
+  if python3 scripts/check-commit-message.py "$tmp" >/dev/null; then got=0; else got=1; fi
+  if [ "$got" = "$1" ]; then pass=$((pass+1)); else fail=$((fail+1)); echo "FAIL (expected $1): $2"; fi
+}
+expect 0 "fix(budget): count budget_hold_leak when a settlement gives up"
+expect 0 "style(backend): ruff format — no code change"
+expect 0 "refactor!: drop the legacy bearer path"
+expect 0 "perf(redis): one shared asyncio client per worker"
+expect 0 "Merge branch 'main' into fix/x"
+expect 0 "fixup! fix(chat): something"
+expect 1 "Update3"
+expect 1 "fixed the bug"
+expect 1 "fix: Add a thing"
+expect 1 "fix(chat): trailing period."
+expect 1 "feat(scope): $(printf 'x%.0s' $(seq 1 120))"
+expect 1 "$(printf 'fix: two lines\nbody without blank line')"
+echo "commit-message: $pass passed, $fail failed"
+[ "$fail" -eq 0 ]
