From f558fe0867fc6e8e6b1ab5025bc174324e407b05 Mon Sep 17 00:00:00 2001
From: Majid Arasskhani <M.Arasskhani@gosilkroad.net>
Date: Mon, 14 Sep 2026 22:58:40 +0000
Subject: [PATCH 11/12] fix(ops): bound container logs and install from the
 latest release tag
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

docker-compose.yml: every service gets `logging: json-file, max-size 50m,
max-file 5` via one x-logging anchor. Without it json-file logs grow until
the disk is full — nginx access log, uvicorn and freshclam alone reach
gigabytes in weeks on a busy host.

install.sh: `curl | sudo bash` cloned `main` unpinned, so every push to main
became root-executed code on the next fresh host (review B-24). The
bootstrap now resolves the newest vX.Y.Z tag with `git ls-remote` and
clones that; `ALPHAROUTER_GIT_REF` still overrides (`main` restores the old
behaviour), and a repo with no release tags falls back to main with a
warning.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UTnpHajSmkk2JMLfuQoV7o
---
 docker-compose.yml | 22 ++++++++++++++++++++++
 scripts/install.sh | 31 ++++++++++++++++++++++++++++++-
 2 files changed, 52 insertions(+), 1 deletion(-)

diff --git a/docker-compose.yml b/docker-compose.yml
index 6b48b3c..39b0c2e 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -1,7 +1,17 @@
 name: alpha-router
 
+# Bounded container logs: without these, json-file logs grow until the disk
+# is full (nginx access log + uvicorn + clamav freshclam alone can do GBs a
+# week). 50 MB x 5 files per container; `docker compose logs` still works.
+x-logging: &default-logging
+  driver: json-file
+  options:
+    max-size: "50m"
+    max-file: "5"
+
 services:
   postgres:
+    logging: *default-logging
     image: postgres:16-alpine
     restart: unless-stopped
     environment:
@@ -31,6 +41,7 @@ services:
       retries: 5
 
   pgbouncer:
+    logging: *default-logging
     image: edoburu/pgbouncer:1.22.1-p0
     restart: unless-stopped
     environment:
@@ -60,6 +71,7 @@ services:
       - alpha_router_app
 
   redis:
+    logging: *default-logging
     image: redis:7-alpine
     restart: unless-stopped
     # Require authentication when REDIS_PASSWORD is set; empty (default) keeps
@@ -81,6 +93,7 @@ services:
       retries: 10
 
   clamav:
+    logging: *default-logging
     image: clamav/clamav:1.5.4-debian13-slim
     restart: unless-stopped
     volumes:
@@ -89,6 +102,7 @@ services:
       - alpha_router_app
 
   qdrant:
+    logging: *default-logging
     image: qdrant/qdrant:v1.19.0
     restart: unless-stopped
     environment:
@@ -110,6 +124,7 @@ services:
   # Primary object storage (SeaweedFS weed mini). S3 API :8333, Admin UI :23646.
   # Pin version via deploy/seaweedfs/VERSION (currently 4.40).
   seaweedfs:
+    logging: *default-logging
     image: chrislusf/seaweedfs:4.40
     restart: unless-stopped
     entrypoint: ["/bin/sh", "/entrypoint.sh"]
@@ -139,6 +154,7 @@ services:
   # spawned on demand as a disposable, network-less container by Alpharouter.
   # Build explicitly with: docker compose build alpha-router-sandbox
   alpha-router-sandbox:
+    logging: *default-logging
     build:
       context: ./sandbox
       dockerfile: Dockerfile
@@ -153,6 +169,7 @@ services:
       - no-new-privileges:true
 
   alpha-router-sandbox-broker:
+    logging: *default-logging
     build:
       context: .
       dockerfile: sandbox-broker/Dockerfile
@@ -212,6 +229,7 @@ services:
 
   # One-shot schema bootstrap + Alembic upgrade. App/workers wait on success.
   db-init:
+    logging: *default-logging
     build:
       context: .
       dockerfile: Dockerfile
@@ -235,6 +253,7 @@ services:
       - alpha_router_app
 
   alpha-router-knowledge-scheduler:
+    logging: *default-logging
     image: alpha-router:latest
     env_file:
       - .env
@@ -257,6 +276,7 @@ services:
       - alpha_router_app
 
   alpha-router-knowledge-worker:
+    logging: *default-logging
     image: alpha-router:latest
     env_file:
       - .env
@@ -293,6 +313,7 @@ services:
       - alpha_router_app
 
   alpha-router:
+    logging: *default-logging
     build:
       context: .
       dockerfile: Dockerfile
@@ -371,6 +392,7 @@ services:
       - alpha_router_sandbox_control
 
   alpha-router-edge:
+    logging: *default-logging
     build:
       context: .
       dockerfile: deploy/edge/Dockerfile
diff --git a/scripts/install.sh b/scripts/install.sh
index ec6e643..cf701cd 100644
--- a/scripts/install.sh
+++ b/scripts/install.sh
@@ -13,7 +13,9 @@ set -euo pipefail
 
 LOG_PREFIX="${LOG_PREFIX:-install}"
 ALPHAROUTER_GIT_URL="${ALPHAROUTER_GIT_URL:-https://github.com/Arasskhani/alpha-router.git}"
-ALPHAROUTER_GIT_REF="${ALPHAROUTER_GIT_REF:-main}"
+# Empty = resolve the newest release tag (vX.Y.Z) at run time. Set to a branch
+# or tag to override; `main` gives the old unpinned behaviour.
+ALPHAROUTER_GIT_REF="${ALPHAROUTER_GIT_REF:-}"
 ALPHAROUTER_HOME="${ALPHAROUTER_HOME:-/opt/alpha-router}"
 
 bootstrap_die() {
@@ -60,10 +62,37 @@ bootstrap_refuse_existing() {
   fi
 }
 
+# Newest semver release tag on the remote, or empty when there is none.
+# `curl | bash` used to clone `main` unpinned: every push to main became root
+# code on the next fresh host. Releases are what was actually tested.
+bootstrap_latest_release_tag() {
+  git ls-remote --tags --refs "$ALPHAROUTER_GIT_URL" 'v[0-9]*' 2>/dev/null \
+    | awk -F/ '{print $NF}' \
+    | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' \
+    | sort -t. -k1,1V -k2,2n -k3,3n \
+    | tail -n 1
+}
+
+bootstrap_resolve_git_ref() {
+  if [ -n "$ALPHAROUTER_GIT_REF" ]; then
+    return 0
+  fi
+  local tag
+  tag="$(bootstrap_latest_release_tag || true)"
+  if [ -n "$tag" ]; then
+    ALPHAROUTER_GIT_REF="$tag"
+    bootstrap_log "Installing latest release $tag (set ALPHAROUTER_GIT_REF to override)."
+  else
+    ALPHAROUTER_GIT_REF="main"
+    bootstrap_log "WARNING: no release tag found on $ALPHAROUTER_GIT_URL; falling back to main."
+  fi
+}
+
 reexec_from_clone() {
   local dest="$ALPHAROUTER_HOME"
   bootstrap_refuse_existing
   bootstrap_minimal_git
+  bootstrap_resolve_git_ref
   if [ ! -f "$dest/scripts/install.sh" ]; then
     if [ -e "$dest" ] && [ -n "$(ls -A "$dest" 2>/dev/null || true)" ]; then
       bootstrap_die "$dest exists and is not an Alpharouter checkout. Set ALPHAROUTER_HOME."
