{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinDigests", ":semanticCommits"],
  "timezone": "Asia/Tehran",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on the first day of the month"] },
  "pip_requirements": {
    "managerFilePatterns": ["/^backend/requirements\\.txt$/", "/^backend/requirements-dev\\.in$/", "/^sandbox(-broker)?/requirements\\.in$/"]
  },
  "packageRules": [
    {
      "description": "Base images: pin and maintain @sha256 digests, group into one MR.",
      "matchManagers": ["dockerfile"],
      "groupName": "base images",
      "pinDigests": true
    },
    {
      "description": "Security-sensitive Python packages are never auto-merged.",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["python3-saml", "cryptography", "python-jose", "ldap3", "bcrypt"],
      "automerge": false
    },
    {
      "description": "The hashed lock is regenerated by `uv pip compile`, not edited by Renovate.",
      "matchFileNames": ["backend/requirements.lock"],
      "enabled": false
    }
  ]
}
